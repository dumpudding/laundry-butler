{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laundry-butler.local/schemas/validation.schema.json",
  "title": "Laundry Butler Episode Validation",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "status",
    "indexed_by",
    "bag_directory",
    "checks",
    "topics"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "warn",
        "fail"
      ]
    },
    "indexed_by": {
      "type": "string"
    },
    "bag_directory": {
      "type": "string"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status",
          "detail"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "warn",
              "fail"
            ]
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "topics": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
